{
  "name": "crossdefense-technology-poc-harness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "install:browsers": "playwright install chromium",
    "preview:poc4": "vite preview --host 127.0.0.1 --port 4174",
    "test:poc4": "npm run build && playwright test --config playwright.poc4.config.ts poc4-offline.spec.ts"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1",
    "vite-plugin-pwa": "1.3.0",
    "workbox-precaching": "7.4.1"
  }
}
